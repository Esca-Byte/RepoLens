{
  "name": "repolens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.3",
    "npm": ">=10"
  },
  "type": "module",
  "productName": "RepoLens",
  "description": "A local-first visual codebase explorer and architecture mapper",
  "author": "RepoLens contributors",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "tauri dev",
    "desktop:package": "tauri build",
    "benchmark:map": "vitest bench benchmarks/map-performance.bench.ts --run",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "check": "npm run typecheck && npm run test -- --run && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@xyflow/react": "12.8.6",
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
